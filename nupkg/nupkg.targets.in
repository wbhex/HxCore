<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Target Name="AfterBuild_@PROJECT_NAME@" AfterTargets="Build">
		<Exec Command="xcopy &quot;$(MSBuildThisFileDirectory)native\bin\*&quot; &quot;$(TargetDir)&quot; /D /Y /S" />
	</Target>
</Project>