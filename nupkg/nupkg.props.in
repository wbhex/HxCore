<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemDefinitionGroup>
		<ClCompile>
			<AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)native\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<AdditionalDependencies>$(MSBuildThisFileDirectory)native\lib\*.lib;$(MSBuildThisFileDirectory)native\bin\*.so;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
    </ItemDefinitionGroup>
</Project>