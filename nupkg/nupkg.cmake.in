set(CURRENT_PACKAGE_NAME "@PROJECT_NAME@")

set(${CURRENT_PACKAGE_NAME}_INCLUDE_DIRECTORIES "${CMAKE_CURRENT_LIST_DIR}/../include/" CACHE STRING  "" FORCE)
set(${CURRENT_PACKAGE_NAME}_BIN_FOLDER "${CMAKE_CURRENT_LIST_DIR}/../bin/" CACHE STRING  "" FORCE)
file(GLOB_RECURSE ${CURRENT_PACKAGE_NAME}_LIBRARIES
	${CMAKE_CURRENT_LIST_DIR}/../bin/*.so
	${CMAKE_CURRENT_LIST_DIR}/../lib/*.lib
	${CMAKE_CURRENT_LIST_DIR}/../lib/*.a
	CACHE STRING  "" FORCE
)